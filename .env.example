# Use the store's myshopify.com domain (or its Shopify-connected custom domain).
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Public Storefront API access token only. Never use an Admin API or private token here.
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=replace-with-public-storefront-token

# Defaults to the latest stable API version as of 2026-11.
VITE_SHOPIFY_API_VERSION=2026-10

# Public Customer Account API client ID from the Shopify Headless sales channel.
VITE_SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=replace-with-public-client-id
